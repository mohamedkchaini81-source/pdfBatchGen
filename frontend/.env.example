# ── Frontend environment variables ───────────────────────────────────────────
# Copy this file to .env and fill in your values.
# Never commit .env to Git.

# URL of the FastAPI backend.
# Local development: leave empty — Vite proxies /api to localhost:8000
# Production (Render): set to your Render backend URL
# Example: https://pdf-batch-gen-backend.onrender.com
VITE_API_URL=
